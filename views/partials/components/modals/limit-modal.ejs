<dialog class="limit-modal modal">
  <button
    class="close-modal-button"
    type="button"
    aria-label="Close write folder name modal"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-x-icon lucide-x"
    >
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </button>
  <h2>Welcome!</h2>
  <p>
    This is a personal showcase project running on free‑tier resources. Please
    note the following limitations:
  </p>
  <ul class="limits">
    <li><strong>Maximum file size:</strong> 5 MB per upload.</li>
    <li><strong>Allowed file types:</strong></li>
  </ul>
  <div class="type-lists">
    <div>
      <h3>Images</h3>
      <ul>
        <li>JPEG (.jpg, .jpeg)</li>
        <li>PNG (.png)</li>
        <li>GIF (.gif)</li>
        <li>WebP (.webp)</li>
        <li>SVG (.svg)</li>
      </ul>
    </div>

    <div>
      <h3>Text</h3>
      <ul>
        <li>Plain Text (.txt)</li>
        <li>CSV (.csv)</li>
        <li>Markdown (.md)</li>
      </ul>
    </div>

    <div>
      <h3>Audio</h3>
      <ul>
        <li>MP3 (.mp3)</li>
        <li>WAV (.wav)</li>
        <li>OGG (.ogg)</li>
        <li>FLAC (.flac)</li>
      </ul>
    </div>

    <div>
      <h3>Video</h3>
      <ul>
        <li>MP4 (.mp4)</li>
        <li>WebM (.webm)</li>
        <li>OGV (.ogv)</li>
        <li>AVI (.avi)</li>
      </ul>
    </div>

    <div>
      <h3>Documents</h3>
      <ul>
        <li>PDF (.pdf)</li>
        <li>Excel (.xlsx, .xls)</li>
        <li>Word (.docx, .doc)</li>
        <li>PowerPoint (.pptx, .ppt)</li>
      </ul>
    </div>

    <div>
      <h3>Archives</h3>
      <ul>
        <li>ZIP (.zip)</li>
        <li>GZIP (.gz)</li>
        <li>7‑Zip (.7z)</li>
      </ul>
    </div>
  </div>
  <button class="confirm-limit modal-button">Got it</button>
</dialog>
